# ─────────────────────────────────────────────────────────────
# tokens.xyz Assets API — resolves tokenized-equity (xStock) variants and
# current prices shown on /portfolio and /alpha/portfolio/[ticker]
# (via lib/data.ts → lib/tokensXyz.ts). Get one from https://app.tokens.xyz/
# When unset, those reads fall back to the bundled data/stocks.json.
# ─────────────────────────────────────────────────────────────
TOKENS_XYZ_API_KEY=

# ─────────────────────────────────────────────────────────────
# EDINET (金融庁) API v2 — backs the paid /api/edinet/{code} lookup.
# Passed as the `Subscription-Key` query parameter; never logged or returned.
# Get one from https://api.edinet-fsa.go.jp/ (free registration).
# REQUIRED for that route: lib/edinet.ts throws when it is unset. The free
# descriptor at /api/edinet works without it.
# Note: financial figures (sales / operating income / net income) are NOT
# served — extraction is paused for reliability, so responses carry disclosure
# metadata + accounting period with financials_available:false.
# ─────────────────────────────────────────────────────────────
EDINET_API_KEY=

# ─────────────────────────────────────────────────────────────
# Claude API — required for the weekly portfolio selection crons
# (update-portfolio / update-jp-portfolio) and the catalyst scoring
# workflow (evaluate-catalysts). Get one from https://console.anthropic.com/
# COST ACTION: every job using this key spends money. See AGENTS.md.
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# Cron / job configuration.
# CRON_SECRET   — auth for /api/cron/*. Callers send `Authorization: Bearer
#                 <CRON_SECRET>`; the cron routes also accept INTERNAL_API_KEY.
#                 Generate with: openssl rand -hex 32
# BENCHMARK_PROVIDER — SPY/QQQ source for the performance job. That job's
#                 schedule is DISABLED (the product no longer tracks returns);
#                 only needed for a manual workflow_dispatch run.
# ─────────────────────────────────────────────────────────────
CRON_SECRET=
BENCHMARK_PROVIDER=yahoo

# ─────────────────────────────────────────────────────────────
# AA external-data integration (optional).
# AA_EXTERNAL_DATA_URL — AA's /api/latest-external-data; the weekly portfolio
#                 cron fetches it (10s timeout, degrades gracefully) and appends
#                 the result to the Claude selection prompt. Unset → skipped.
# ─────────────────────────────────────────────────────────────
AA_EXTERNAL_DATA_URL=

# ─────────────────────────────────────────────────────────────
# Internal-auth bypass for x402 (skips payment when caller sends
# `X-Internal-Key: <value>`). Used by AA / your own backend.
# Generate one with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────
INTERNAL_API_KEY=

# ─────────────────────────────────────────────────────────────
# x402 v2 — receiving wallets per network
# Paid surface (all Solana-only since 2026-09 — docs/facilitator-design.md §4):
# /api/alpha/... ($0.01),
# /api/catalyst/{ticker} and /api/edinet/{code} (0.001 USDC, Solana only —
# lib/x402.ts PER_CALL_PRICE), /api/testnet/signal ($0.05, Base Sepolia).
# Base mainnet (USDC).      eip155:8453
# Solana mainnet (USDC).    solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
# Both default to the addresses hard-coded in lib/x402.ts; override
# here to receive at a different wallet.
# SOLANA_RECEIVE_ADDRESS is the canonical Solana payTo (takes precedence over
# WALLET_ADDRESS_SOLANA); set it to the address that should receive Solana USDC.
# ─────────────────────────────────────────────────────────────
WALLET_ADDRESS_BASE=0xC67d94504696960bA0f2e7C3FeE703950734c00A
WALLET_ADDRESS_SOLANA=4s8XQC2WzRfgH8Xiep7ybnCW11VKRCMwxQF6jknx3VPf
SOLANA_RECEIVE_ADDRESS=

# ─────────────────────────────────────────────────────────────
# Facilitator selection — Base (EVM) verify/settle. UNCHANGED.
# Priority: (1) CDP_API_KEY_ID + CDP_API_KEY_SECRET → @coinbase/x402
#           (2) FACILITATOR_URL → custom HTTP facilitator
#           (3) default → @coinbase/x402 anonymous facilitator
# ─────────────────────────────────────────────────────────────
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
FACILITATOR_URL=

# ─────────────────────────────────────────────────────────────
# PayAI facilitator — Solana (solana:*) verify/settle.
# Added as a second facilitator client so Solana USDC payments are verified by
# PayAI (https://facilitator.payai.network) while Base stays on CDP above.
# Free tier needs NO keys. Set both for credited/JWT-authed access (prod scale).
# Secret may be raw base64 or `payai_sk_` prefixed.
# ─────────────────────────────────────────────────────────────
PAYAI_API_KEY_ID=
PAYAI_API_KEY_SECRET=

# ─────────────────────────────────────────────────────────────
# Testnet demo path (Base Sepolia) — /api/testnet/signal only.
# Never touches the mainnet Base/Solana settlement path.
# ─────────────────────────────────────────────────────────────
X402_TESTNET_SIGNAL_PRICE=
X402_TESTNET_PAY_TO=
X402_TESTNET_FACILITATOR_URL=

# ─────────────────────────────────────────────────────────────
# Canonical origin advertised in x402 `resource` URLs and in
# /.well-known/x402.json. Defaults to https://osd.x402jp.com
# ─────────────────────────────────────────────────────────────
X402_PUBLIC_BASE_URL=
